# OpenAI-compatible LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: override base URL for compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1

# JSearch on RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JSEARCH_API_KEY=your-rapidapi-key

# Discord channel webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Scout backend: local (MVP) | cursor (not implemented yet)
SCOUT_BACKEND=local

# Optional paths (defaults relative to project root)
# RESUME_PATH=data/resume.md
# PROJECTS_PATH=data/projects.md
# OUTPUT_DIR=output

# Search preferences
# JOB_LOCATION=Remote
# JOBS_PER_ROLE=3
# MAX_ROLES=5
# MAX_JOBS=10
